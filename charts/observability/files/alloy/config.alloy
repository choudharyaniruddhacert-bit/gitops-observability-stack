// ---------- Logging of Alloy itself ----------
logging {
  level  = "info"
  format = "logfmt"
}

// =====================  LOGS (P3)  =====================

// 1. Discover all pods in the cluster
discovery.kubernetes "pods" {
  role = "pod"
}

// 2. Turn K8s metadata into Loki labels
discovery.relabel "pods" {
  targets = discovery.kubernetes.pods.targets

  rule {
    source_labels = ["__meta_kubernetes_namespace"]
    target_label  = "namespace"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_name"]
    target_label  = "pod"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_container_name"]
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_kubernetes_pod_label_app_kubernetes_io_name"]
    target_label  = "app"
  }
}

// 3. Read pod logs through the Kubernetes API
loki.source.kubernetes "pods" {
  targets    = discovery.relabel.pods.output
  forward_to = [loki.write.default.receiver]
}

// 4. Collect Kubernetes events
loki.source.kubernetes_events "events" {
  job_name   = "kubernetes-events"
  log_format = "logfmt"
  forward_to = [loki.write.default.receiver]
}

// 5. Push logs to Loki
loki.write "default" {
  endpoint {
    url = "http://observability-loki:3100/loki/api/v1/push"
  }
}

// =====================  TRACES (P4)  =====================

// 6. Receive traces from apps over OTLP (gRPC 4317, HTTP 4318)
otelcol.receiver.otlp "default" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }

  http {
    endpoint = "0.0.0.0:4318"
  }

  output {
    traces = [otelcol.processor.batch.default.input]
  }
}

// 7. Batch spans before sending (fewer, bigger requests)
otelcol.processor.batch "default" {
  output {
    traces = [otelcol.exporter.otlp.tempo.input]
  }
}

// 8. Send traces to Tempo over OTLP gRPC
otelcol.exporter.otlp "tempo" {
  client {
    endpoint = "observability-tempo:4317"

    tls {
      insecure = true
    }
  }
}